<?xml version="1.0"?>
<window>
  <width>1600</width><height>1000</height>
  <menus><drawer visible="true" default="true"/><plugins visible="true" from_paths="true"/></menus>
</window>
<plugin filename="MinimalScene" name="3D View">
  <gz-gui><title>3D View</title><property type="bool" key="showTitleBar">false</property><property type="string" key="state">docked</property></gz-gui>
  <engine>ogre2</engine><scene>scene</scene>
  <camera_pose>11 -7 2.7 0 0.37 2.35</camera_pose>
</plugin>
<plugin filename="GzSceneManager" name="Scene Manager"><gz-gui><property type="bool" key="showTitleBar">false</property><property type="string" key="state">floating</property><property type="double" key="height">0</property><property type="double" key="width">0</property><property type="bool" key="visible">false</property></gz-gui></plugin>
<plugin filename="InteractiveViewControl" name="Interactive view control"><gz-gui><property type="bool" key="showTitleBar">false</property><property type="string" key="state">floating</property><property type="double" key="height">0</property><property type="double" key="width">0</property><property type="bool" key="visible">false</property></gz-gui></plugin>
<plugin filename="CameraTracking" name="Camera tracking"><gz-gui><property type="bool" key="showTitleBar">false</property><property type="string" key="state">floating</property><property type="double" key="height">0</property><property type="double" key="width">0</property><property type="bool" key="visible">false</property></gz-gui></plugin>
<plugin filename="EntityContextMenuPlugin" name="Entity context menu"><gz-gui><property type="bool" key="showTitleBar">false</property><property type="string" key="state">floating</property><property type="double" key="height">0</property><property type="double" key="width">0</property><property type="bool" key="visible">false</property></gz-gui></plugin>
<plugin filename="Screenshot" name="Screenshot"><gz-gui><property type="bool" key="showTitleBar">false</property><property type="string" key="state">floating</property><property type="double" key="height">0</property><property type="double" key="width">0</property><property type="bool" key="visible">false</property></gz-gui></plugin>
<plugin filename="WorldControl" name="World control">
  <gz-gui><title>World control</title><property type="bool" key="showTitleBar">false</property><property type="string" key="state">floating</property><property type="double" key="height">72</property><property type="double" key="width">200</property><anchors target="3D View"><line own="left" target="left"/><line own="bottom" target="bottom"/></anchors></gz-gui>
  <play_pause>true</play_pause><step>true</step><start_paused>false</start_paused>
</plugin>
<plugin filename="WorldStats" name="World stats">
  <gz-gui><title>World stats</title><property type="bool" key="showTitleBar">false</property><property type="string" key="state">floating</property><property type="double" key="height">80</property><property type="double" key="width">300</property><anchors target="3D View"><line own="right" target="right"/><line own="bottom" target="bottom"/></anchors></gz-gui>
  <sim_time>true</sim_time><real_time>true</real_time><real_time_factor>true</real_time_factor><iterations>false</iterations>
</plugin>
<plugin filename="EntityTree" name="Entity tree"><gz-gui><title>Entity tree</title><property type="bool" key="showTitleBar">false</property><property type="string" key="state">docked</property></gz-gui></plugin>
